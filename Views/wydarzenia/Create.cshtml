@model Grzmotoptak.Models.wydarzenia

@{
    ViewData["Title"] = "Stworzenie wydarzenia";
}

<h2>Stworzenie wydarzenia</h2>


<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    
    <div class="form-group">
        <label asp-for="Tytul" class="control-label"></label>
        <input asp-for="Tytul" class="form-control" />
       
        <span asp-validation-for="Tytul" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Opis" class="control-label"></label>
        <textarea asp-for="Opis" class="form-control"></textarea>
        
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Data" class="control-label"></label>
        <input asp-for="Data" class="form-control" type="datetime-local" />
        
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Typ" class="control-label"></label>
        <select asp-for="Typ" class="form-control" asp-items="@(new SelectList(ViewBag.TypyWydarzen))">
            <option value="">-- Wybierz typ --</option>
        </select>
        <span asp-validation-for="Typ" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Obrazek" class="control-label"></label>
        <input type="file" asp-for="Obrazek" class="form-control" />
        <span asp-validation-for="Obrazek" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Stwórz</button>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
